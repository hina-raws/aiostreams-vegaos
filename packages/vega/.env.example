# The Vega app itself needs no environment: the server address is typed into the
# app on first run and kept on the device.
#
# These are for running an AIOStreams backend of your own to test against. Copy
# this file to `.env` in the root of your AIOStreams clone.

# The address the server is reached at, with protocol and port. It is what the
# addon's install URLs are built from, so it must be an address your TV can read.
BASE_URL=http://192.168.1.10:3001

# 64 hex characters: `openssl rand -hex 32`. Cannot change once the database
# exists — every stored addon configuration is encrypted with it.
SECRET_KEY=replace-with-64-hex-characters

# SQLite keeps everything in one file.
DATABASE_URI=sqlite://./data/db.sqlite

PORT=3001
LOG_LEVEL=info
